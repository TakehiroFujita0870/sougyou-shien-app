# Dormant deployment template. Do not install or activate before credential
# rotation and private-projection review are complete and separately approved.
[Unit]
Description=Dots live Founder Graph API
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/projects/dots-live
EnvironmentFile=%h/.config/dots/live-control-plane.env
Environment=DOTS_NEO4J_AUTH_FILE=%h/.config/dots/live-neo4j-auth.secret
Environment=DOTS_DOCKER_CLI=/mnt/c/Users/hp/AppData/Local/Programs/DockerDesktop/resources/bin/docker.exe
Environment=PYTHONPATH=%h/projects/dots-live/backend
Environment=DOTS_CONNECTION_PROFILE=live
Environment=DOTS_GRAPH_BACKEND=neo4j
Environment=DOTS_LOCAL_OWNER_ID=owner-mvp
Environment=DOTS_NEO4J_DATABASE=neo4j
Environment=DOTS_NEO4J_URI=bolt://127.0.0.1:7687
Environment=DOTS_SEARCH_PROFILE=base
Environment=DOTS_SEARCH_RERANK_ENABLED=1
Environment=DOTS_SEARCH_RERANK_CANDIDATE_LIMIT=40
# These explicit gates keep this template inert until separately approved.
Environment=DOTS_LIVE_CREDENTIAL_ROTATION_CONFIRMED=0
Environment=DOTS_LIVE_EGRESS_REVIEW_CONFIRMED=0
ExecStartPre=%h/.local/bin/uv run --project %h/projects/dots-live python -c "from dots.main import app; from dots.founder_graph_runtime import create_neo4j_driver_from_env; driver=create_neo4j_driver_from_env(); driver.verify_connectivity(); driver.close()"
ExecStart=%h/.local/bin/uv run --project %h/projects/dots-live uvicorn --app-dir backend dots.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15
UMask=0077
